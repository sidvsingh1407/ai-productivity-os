def generate_benchmark_insights(
    organization_total_score: float,
    platform_average: float,
    percentile_rank: int,
    sample_size: int,
    dimension_comparisons: Dict[str, Dict[str, Union[float, int]]]
) -> Dict[str, Any]:
    # A - Overall Benchmark Summary
    total_diff = int(round(organization_total_score)) - int(round(platform_average))
    abs_diff = abs(total_diff)
    if total_diff > 0:
        relation = "above"
    elif total_diff < 0:
        relation = "below"
    else:
        relation = "in line with"

    overall_summary = f"Your organization performs {relation} the current platform average by {abs_diff} points and ranks in the {percentile_rank}th percentile based on {sample_size} completed assessments."

    if not dimension_comparisons:
        return {
            "overall_summary": overall_summary,
            "strongest_dimension": None,
            "weakest_dimension": None,
            "dimension_insights": [],
            "improvement_opportunity": None
        }

    # Helper for sorting: we want deterministic tie-breaking based on first encountered dimension.
    # Python dictionaries maintain insertion order since 3.7.
    dimensions_info = []
    for dim, data in dimension_comparisons.items():
        dimensions_info.append({
            "dimension": dim.capitalize(),
            "difference": data["difference"]
        })

    # B - Strongest Dimension
    # Rule: largest positive diff, if all negative, least negative diff.
    # max() on diff will naturally pick largest positive, or least negative if all are negative.
    # To handle ties for strongest (first encountered):
    strongest_dim_info = max(dimensions_info, key=lambda x: x["difference"])
    strongest_dimension = {
        "dimension": strongest_dim_info["dimension"],
        "difference": strongest_dim_info["difference"],
        "insight": f"{strongest_dim_info['dimension']} is currently your strongest area relative to benchmark organizations."
    }

    # C - Weakest Dimension
    # Rule: largest negative diff. If tied, use largest absolute gap (same as largest negative).
    # If still tied, use first encountered.
    # min() on diff gets largest negative.
    weakest_dim_info = min(dimensions_info, key=lambda x: x["difference"])
    weakest_dimension = {
        "dimension": weakest_dim_info["dimension"],
        "difference": weakest_dim_info["difference"],
        "insight": f"{weakest_dim_info['dimension']} trails the benchmark and represents the largest improvement opportunity."
    }

    # D - Dimension Insights
    dimension_insights = []
    for info in dimensions_info:
        dim = info["dimension"]
        diff = info["difference"]
        if diff > 0:
            insight_text = f"{dim} exceeds the benchmark by {diff} points."
        elif diff < 0:
            insight_text = f"{dim} is {abs(diff)} points below benchmark."
        else:
            insight_text = f"{dim} is currently aligned with the benchmark average."

        dimension_insights.append({
            "dimension": dim,
            "insight": insight_text
        })

    # E - Improvement Opportunity
    negative_gaps = [info for info in dimensions_info if info["difference"] < 0]
    if negative_gaps:
        # Use largest negative gap (min difference)
        opportunity_dim = min(negative_gaps, key=lambda x: x["difference"])["dimension"]
        improvement_opportunity = f"Improving {opportunity_dim} would have the largest impact on overall benchmark positioning."
    else:
        # Use smallest positive gap (min difference among non-negative ones)
        # Note: If difference = 0, that's not exactly a "positive gap" but it falls here.
        # Let's check non-negative (diff >= 0) to be safe.
        positive_gaps = [info for info in dimensions_info if info["difference"] >= 0]
        # To strictly use the smallest positive gap if no negative gaps exist:
        opportunity_dim = min(positive_gaps, key=lambda x: x["difference"])["dimension"]
        improvement_opportunity = f"Further improving {opportunity_dim} represents the largest remaining opportunity for differentiation."

    return {
        "overall_summary": overall_summary,
        "strongest_dimension": strongest_dimension,
        "weakest_dimension": weakest_dimension,
        "dimension_insights": dimension_insights,
        "improvement_opportunity": improvement_opportunity
    }

def generate_benchmark_payload(organization_total_score: float, organization_dimension_scores: Dict[str, float], assessments: List[Any]) -> Dict[str, Any]:
    sample_size = len(assessments)
    validation_error = validate_sample_size(sample_size)
    if validation_error:
        return validation_error

    platform_average = calculate_platform_average(assessments)
    dimension_averages = calculate_dimension_averages(assessments)
    percentile_rank = calculate_percentile_rank(organization_total_score, assessments)
    dimension_comparisons = calculate_dimension_comparison(organization_dimension_scores, dimension_averages)

    insights = generate_benchmark_insights(
        organization_total_score=organization_total_score,
        platform_average=platform_average,
        percentile_rank=percentile_rank,
        sample_size=sample_size,
        dimension_comparisons=dimension_comparisons
    )

    return {
        "benchmark_available": True,
        "sample_size": sample_size,
        "platform_average": platform_average,
        "percentile_rank": percentile_rank,
        "dimension_comparisons": dimension_comparisons,
        "benchmark_insights": insights
    }
